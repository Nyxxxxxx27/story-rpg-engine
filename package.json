{
  "name": "story-rpg-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx apps/api/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "start": "node dist/server/api/main.js",
    "start:worker": "node dist/server/worker/main.js",
    "mcp": "tsx apps/mcp/main.ts",
    "test:recovery": "vitest run tests/recovery.test.ts",
    "test:shutdown": "tsx scripts/codex-shutdown-smoke.ts",
    "test:three-day": "tsx scripts/three-day-acceptance.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.17.0",
    "fastify": "5.12.1",
    "lucide-react": "1.38.0",
    "openai": "7.8.0",
    "pg": "8.23.0",
    "pg-boss": "12.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
