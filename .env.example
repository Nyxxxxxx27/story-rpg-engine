# Defaults use an embedded local PostgreSQL-compatible database under .data/.
# Set DATABASE_URL only when you explicitly want an external PostgreSQL server.
DATABASE_URL=
STORY_DATA_DIR=.data/story-postgres
HOST=127.0.0.1
PORT=4310

# Codex Provider uses the signed-in local Codex App Server. Model is optional.
CODEX_MODEL=gpt-5.6-luna

# The OpenAI API backend is never selected automatically. Add a key only when a
# story is explicitly configured with provider=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

STORY_API_URL=http://127.0.0.1:4310/api/v2
